version: '3.8'

services:
  devops-platform:
    image: devops-platform:latest
    container_name: devops-platform
    expose:
      - "3000"
    restart: always

  reverse-proxy:
    image: nginx:alpine
    container_name: nginx_proxy
    ports:
      - "{{ nginx_port }}:80"
    volumes:
      - /opt/devops-platform/nginx/conf.d:/etc/nginx/conf.d:ro
    depends_on:
      - devops-platform
    restart: always
